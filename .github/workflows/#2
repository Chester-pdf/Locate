          package dev.locatemod;

          import com.google.gson.JsonArray;
          import com.google.gson.JsonElement;
          import com.google.gson.JsonObject;
          import com.google.gson.JsonParser;

          import java.io.InputStreamReader;
          import java.nio.charset.StandardCharsets;
          import java.util.ArrayList;
          import java.util.List;
          import java.util.Locale;

          /** Словарь «разговорное название (RU/EN) -> ID построек/биомов». Файл: resources/locatemod/aliases.json */
          public final class Aliases {
              public record Entry(boolean structure, List<String> names, List<String> ids) {
                  public String displayName() {
                      String n = names.get(0);
                      return n.substring(0, 1).toUpperCase(Locale.ROOT) + n.substring(1);
                  }
              }

              private static final List<Entry> ENTRIES = new ArrayList<>();

              private Aliases() {}

              public static void load() {
                  ENTRIES.clear();
                  try (var in = Aliases.class.getResourceAsStream("/locatemod/aliases.json")) {
                      if (in == null) return;
                      JsonArray arr = JsonParser.parseReader(new InputStreamReader(in, StandardCharsets.UTF_8)).getAsJsonArray();
                      for (JsonElement el : arr) {
                          JsonObject o = el.getAsJsonObject();
                          List<String> names = new ArrayList<>();
                          o.getAsJsonArray("names").forEach(n -> names.add(norm(n.getAsString())));
                          List<String> ids = new ArrayList<>();
                          o.getAsJsonArray("ids").forEach(i -> ids.add(i.getAsString()));
                          ENTRIES.add(new Entry(o.get("kind").getAsString().equals("structure"), names, ids));
                      }
                  } catch (Exception e) {
                      throw new RuntimeException("locatemod: не удалось прочитать aliases.json", e);
                  }
              }

              public static String norm(String s) {
                  return s.toLowerCase(Locale.ROOT).replace('ё', 'е').replace('_', ' ').replace('-', ' ').trim();
              }

              /** Сначала точное совпадение, потом частичное (для слов от 3 букв). */
              public static Entry find(String query) {
                  String q = norm(query);
                  for (Entry e : ENTRIES) if (e.names().contains(q)) return e;
                  if (q.length() >= 3) {
                      for (Entry e : ENTRIES)
                          for (String n : e.names())
                              if (n.contains(q) || q.contains(n)) return e;
                  }
                  return null;
              }
          }
