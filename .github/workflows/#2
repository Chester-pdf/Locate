          package dev.locatemod.client;

          import dev.locatemod.LocatePayload;
          import net.fabricmc.fabric.api.client.networking.v1.ClientPlayNetworking;
          import net.minecraft.client.gui.components.Button;
          import net.minecraft.client.gui.components.EditBox;
          import net.minecraft.client.gui.screens.Screen;
          import net.minecraft.network.chat.Component;

          /** Экран с одной строкой ввода. Без собственной отрисовки, чтобы не зависеть от внутренностей GUI. */
          public class LocateScreen extends Screen {
          	private EditBox input;

          	public LocateScreen() {
          		super(Component.literal("Поиск"));
          	}

          	@Override
          	protected void init() {
          		int w = 200;
          		int x = this.width / 2 - w / 2;
          		int y = this.height / 2 - 40;

          		// Заголовок — неактивная кнопка (лейбл без своей отрисовки).
          		Button heading = Button.builder(Component.literal("Что найти? Постройка или биом"), b -> {})
          				.bounds(x, y, w, 20).build();
          		heading.active = false;
          		this.addRenderableWidget(heading);

          		this.input = new EditBox(this.font, x, y + 26, w, 20, Component.literal("Запрос"));
          		this.input.setMaxLength(64);
          		this.addRenderableWidget(this.input);
          		this.setInitialFocus(this.input);

          		this.addRenderableWidget(Button.builder(Component.literal("Найти"), b -> submit())
          				.bounds(x, y + 52, 98, 20).build());
          		this.addRenderableWidget(Button.builder(Component.literal("Отмена"), b -> this.onClose())
          				.bounds(x + 102, y + 52, 98, 20).build());
          	}

          	private void submit() {
          		String q = this.input.getValue().trim();
          		if (!q.isEmpty() && ClientPlayNetworking.canSend(LocatePayload.TYPE)) {
          			ClientPlayNetworking.send(new LocatePayload(q));
          		}
          		this.onClose(); // закрываем всё, чтобы был виден чат
          	}
          }
