          package dev.locatemod;

          import com.mojang.datafixers.util.Pair;
          import net.fabricmc.api.ModInitializer;
          import net.fabricmc.fabric.api.networking.v1.PayloadTypeRegistry;
          import net.fabricmc.fabric.api.networking.v1.ServerPlayNetworking;
          import net.minecraft.core.BlockPos;
          import net.minecraft.core.Holder;
          import net.minecraft.core.HolderSet;
          import net.minecraft.core.registries.Registries;
          import net.minecraft.network.chat.Component;
          import net.minecraft.resources.Identifier;
          import net.minecraft.resources.ResourceKey;
          import net.minecraft.server.level.ServerLevel;
          import net.minecraft.server.level.ServerPlayer;
          import net.minecraft.world.level.biome.Biome;
          import net.minecraft.world.level.levelgen.structure.Structure;

          import java.util.ArrayList;
          import java.util.HashSet;
          import java.util.List;
          import java.util.Set;

          public class LocateMod implements ModInitializer {
              private static final int STRUCTURE_RADIUS_CHUNKS = 100; // как у ванильного /locate
              private static final int BIOME_RADIUS_BLOCKS = 6400;

              @Override
              public void onInitialize() {
                  Aliases.load();
                  PayloadTypeRegistry.serverboundPlay().register(LocatePayload.TYPE, LocatePayload.CODEC);
                  ServerPlayNetworking.registerGlobalReceiver(LocatePayload.TYPE,
                          (payload, ctx) -> handle(ctx.player(), payload.query()));
              }

              private static void handle(ServerPlayer player, String query) {
                  ServerLevel level = (ServerLevel) player.level();
                  BlockPos origin = player.blockPosition();

                  boolean structure;
                  List<String> ids;
                  String title;

                  Aliases.Entry entry = Aliases.find(query);
                  if (entry != null) {
                      structure = entry.structure();
                      ids = entry.ids();
                      title = entry.displayName();
                  } else {
                      // запасной вариант: игрок ввёл технический ID, например "trial_chambers"
                      Identifier id = Identifier.tryParse(query.trim().toLowerCase().replace(' ', '_'));
                      if (id == null) { notFound(player, query); return; }
                      var structures = level.registryAccess().lookupOrThrow(Registries.STRUCTURE);
                      var biomes = level.registryAccess().lookupOrThrow(Registries.BIOME);
                      if (structures.get(ResourceKey.create(Registries.STRUCTURE, id)).isPresent()) {
                          structure = true;
                      } else if (biomes.get(ResourceKey.create(Registries.BIOME, id)).isPresent()) {
                          structure = false;
                      } else { notFound(player, query); return; }
                      ids = List.of(id.getPath());
                      title = query.trim();
                  }

                  BlockPos found = structure ? findStructure(level, origin, ids) : findBiome(level, origin, ids);
                  if (found == null) {
                      player.sendSystemMessage(Component.literal(
                              title + ": не найдено поблизости (возможно, этого нет в текущем измерении)"));
                      return;
                  }
                  int dist = (int) Math.round(Math.hypot(found.getX() - origin.getX(), found.getZ() - origin.getZ()));
                  player.sendSystemMessage(Component.literal(
                          title + ": в " + dist + " бл. отсюда (X: " + found.getX() + ", Z: " + found.getZ() + ")"));
              }

              private static void notFound(ServerPlayer player, String query) {
                  player.sendSystemMessage(Component.literal("Не знаю такую постройку или биом: «" + query + "»"));
              }

              private static BlockPos findStructure(ServerLevel level, BlockPos origin, List<String> ids) {
                  var reg = level.registryAccess().lookupOrThrow(Registries.STRUCTURE);
                  List<Holder<Structure>> holders = new ArrayList<>();
                  for (String id : ids) {
                      reg.get(ResourceKey.create(Registries.STRUCTURE, Identifier.withDefaultNamespace(id)))
                              .ifPresent(holders::add);
                  }
                  if (holders.isEmpty()) return null;
                  Pair<BlockPos, Holder<Structure>> res = level.getChunkSource().getGenerator()
                          .findNearestMapStructure(level, HolderSet.direct(holders), origin, STRUCTURE_RADIUS_CHUNKS, false);
                  return res == null ? null : res.getFirst();
              }

              private static BlockPos findBiome(ServerLevel level, BlockPos origin, List<String> ids) {
                  Set<ResourceKey<Biome>> keys = new HashSet<>();
                  for (String id : ids) keys.add(ResourceKey.create(Registries.BIOME, Identifier.withDefaultNamespace(id)));
                  Pair<BlockPos, Holder<Biome>> res = level.findClosestBiome3d(
                          h -> h.unwrapKey().map(keys::contains).orElse(false),
                          origin, BIOME_RADIUS_BLOCKS, 32, 64);
                  return res == null ? null : res.getFirst();
              }
          }
          LOCATEMOD_EOF
