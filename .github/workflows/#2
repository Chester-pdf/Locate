          package dev.locatemod;

          import net.minecraft.network.RegistryFriendlyByteBuf;
          import net.minecraft.network.codec.ByteBufCodecs;
          import net.minecraft.network.codec.StreamCodec;
          import net.minecraft.network.protocol.common.custom.CustomPacketPayload;
          import net.minecraft.resources.Identifier;

          /** Клиент -> сервер: текст запроса, который ввёл игрок. */
          public record LocatePayload(String query) implements CustomPacketPayload {
          	public static final Type<LocatePayload> TYPE =
          			new Type<>(Identifier.fromNamespaceAndPath("locatemod", "locate"));

          	public static final StreamCodec<RegistryFriendlyByteBuf, LocatePayload> CODEC =
          			StreamCodec.composite(ByteBufCodecs.stringUtf8(64), LocatePayload::query, LocatePayload::new);

          	@Override
          	public Type<? extends CustomPacketPayload> type() {
          		return TYPE;
          	}
          }
